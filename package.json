{
  "name": "loteria-generator",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "next build",
    "dev": "pnpm secrets:pull && concurrently --names next,inngest --prefix-colors cyan,magenta \"next dev --port 3006\" \"inngest-cli dev --no-discovery --port 8288 -u http://localhost:3006/api/inngest\"",
    "socket:dev": "tsx watch socket/index.ts",
    "socket:build": "tsup",
    "socket:probe": "tsx scripts/socket-idle-probe.ts",
    "dev:next": "next dev --port 3006",
    "dev:inngest": "inngest-cli dev --no-discovery --port 8288 -u http://localhost:3006/api/inngest",
    "email:dev": "email dev --dir emails --port 3007",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "tsx scripts/e2e-run.ts",
    "test:e2e:ui": "playwright test --ui",
    "e2e:branch:create": "tsx scripts/e2e-branch-create.ts",
    "e2e:branch:destroy": "tsx scripts/e2e-branch-destroy.ts",
    "e2e:seed-user": "tsx scripts/e2e-seed-user.ts",
    "e2e:reset": "tsx -e 'import(\"./e2e/helpers/cleanup\").then(async ({deleteBoardsForUser}) => { const {getUserIdByEmail} = await import(\"./e2e/helpers/get-user-id\"); const id = await getUserIdByEmail(\"e2etest@example.com\"); await deleteBoardsForUser(id); console.log(\"reset done\"); })'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:journal": "tsx scripts/backfill-migration-journal.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky",
    "secrets:pull": "vercel env pull .env.local",
    "generate:examples": "tsx --env-file=.env.local scripts/example-images/generate-illustrations.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.10.0",
