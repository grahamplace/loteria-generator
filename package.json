    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "inngest-cli": "^1.17.9",
    "jsdom": "^24.1.3",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5",
    "prettier": "^3.8.1",
    "react-email": "^6.6.4",
    "tailwindcss": "^4.1.9",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "tw-animate-css": "1.3.3",
