# example illustration outputs — full-resolution PNGs and run manifest from
# the generator script. Optimized webp copies live in
# lib/hero-cards-illustrations/ and ARE checked in. Regenerate with
# `pnpm generate:examples`.
/scripts/example-images/illustrations/

# image model eval runs (`pnpm eval:images`): generated PNGs + comparison sheets
/scripts/image-eval/runs/
# Tricky eval set pulled from prod (`pnpm eval:pull-tricky`): customer photos, never commit
/scripts/image-eval/photos-tricky/
# Objects eval set: pasted photos with unknown licenses, keep local
/scripts/image-eval/photos-objects/

