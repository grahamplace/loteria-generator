# Copy to .env.test (gitignored) and fill in the five test-infra values.
# These five are the only ones that need to be set as GitHub Actions secrets.
# The Stripe + skip-AI vars below are hardcoded dummies — no real Stripe
# account needed; the webhook helper just signs and verifies with the same
# secret.

NEON_API_KEY=
NEON_PROJECT_ID=
NEON_TEST_BASE_BRANCH_ID=
E2E_BETTER_AUTH_SECRET=
E2E_TEST_PASSWORD=

# Stripe (test mode dummies — keep in sync with .github/workflows/ci.yml)
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_PRICE_ID=price_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_dummy

# Other dummies — present so the dev server can boot during E2E
OPENAI_API_KEY=sk-dummy
NEXT_PUBLIC_APP_URL=http://localhost:3006

# Skip Inngest AI processing — cards complete synchronously with original image
NEXT_PUBLIC_SKIP_AI_PROCESSING=true
