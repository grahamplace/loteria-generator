# Copy to .env.test (gitignored) and fill in values from the maintainer.
# All five are also set as GitHub Actions secrets for CI.

NEON_API_KEY=
NEON_PROJECT_ID=
NEON_TEST_BASE_BRANCH_ID=
E2E_BETTER_AUTH_SECRET=
E2E_TEST_PASSWORD=

# Stripe (test mode). The same values must be set in both .env.test and as
# GitHub secrets. The webhook helper signs fixtures with STRIPE_WEBHOOK_SECRET
# and the app verifies with the same secret — they only need to match each
# other (any whsec_ / sk_test_ formatted strings work).
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_PRICE_ID=price_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_test_changeme
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_dummy

# Other dummies — present so the dev server can boot during E2E
OPENAI_API_KEY=sk-dummy
NEXT_PUBLIC_APP_URL=http://localhost:3006

# Skip Inngest AI processing — cards complete synchronously with original image
NEXT_PUBLIC_SKIP_AI_PROCESSING=true
